{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "domains": {
      "project": "recommended",
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off",
        "noDocumentCookie": "off",
        "noConsole": "error",
        "noConstEnum": "error",
        "noConstantBinaryExpressions": "error",
        "noUnassignedVariables": "error",
        "noVar": "error",
        "noWith": "error",
        "useArraySortCompare": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noNestedTernary": "error",
        "noParameterAssign": "error",
        "noSubstr": "error",
        "useThrowOnlyError": "error",
        "useThrowNewError": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useShorthandAssign": "error",
        "noYodaExpression": "error",
        "useForOf": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useDefaultParameterLast": "error",
        "useDefaultSwitchClause": "error",
        "useExplicitLengthCheck": "error",
        "useNumberNamespace": "error",
        "useTrimStartEnd": "error"
      },
      "complexity": {
        "noImportantStyles": "off",
        "noUselessCatchBinding": "error",
        "useArrayFind": "error",
        "useLiteralKeys": "off",
        "useMathMinMax": "error"
      },
      "correctness": {
        "noNestedComponentDefinitions": "error",
        "noUndeclaredVariables": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noDelete": "error",
        "useDomNodeTextContent": "error",
        "useTopLevelRegex": "error"
      },
      "nursery": {
        "noAsyncPromiseFinally": "error",
        "noDuplicateTypeConstituents": "error",
        "noInvalidFetchOptions": "error",
        "noNewArray": "error",
        "noRedundantTypeConstituents": "error",
        "noUselessFallbackInSpread": "error",
        "noUselessParameterPropertyAssignment": "error",
        "noUselessSpread": "error",
        "useAtomicUpdates": "error",
        "useConsistentTupleLabels": "error",
        "useGlobalRegexInMatchAll": "error",
        "useGlobalRegexInReplaceAll": "error",
        "useValidCharacterComparison": "error",
        "noUselessQualifier": "error",
        "noArrayMethodsOnArguments": "error",
        "noConstantComparisons": "error",
        "noErasingOperation": "error",
        "noNegatedArrayPredicate": "error",
        "noNumberArgumentOutOfRange": "error",
        "noSharedBranchCode": "error",
        "noSubtractionComparison": "error",
        "noUninvokedArrayCallback": "error",
        "noAwaitInPromiseMethods": "error",
        "noChainedComparison": "error",
        "noDynamicDelete": "error",
        "noLateEventControl": "error",
        "noMapSpread": "error",
        "noMismatchedMapKey": "error",
        "noMissingThrow": "error",
        "noObjectLiteralComparison": "error",
        "noPseudoElementInFunctionalPseudoClass": "error",
        "noSinglePromiseInPromiseMethods": "error",
        "noUnnecessaryStringTrim": "error",
        "noUselessAwait": "error",
        "noUselessLengthCheck": "error",
        "noUselessTypeAssertion": "error",
        "useSimplifiedBooleanReturn": "error",
        "noMagicArrayFlatDepth": "error",
        "noNewRequire": "error",
        "noObsoleteAttributes": "error",
        "noPathConcat": "error",
        "noSelfNestedLayer": "error",
        "noShortTimeValues": "error",
        "noUnreadableIife": "error",
        "noUselessRecursion": "error",
        "noUselessSplice": "error",
        "noYamlBooleanKeys": "error",
        "noZeroLengthUnit": "error",
        "useBlockStatementOverIife": "error",
        "useConsistentLightnessNotation": "error",
        "useConsistentUnicodeBom": "error",
        "useIteratorZip": "error",
        "useMathAbs": "error",
        "useMathTrunc": "error",
        "useWhileLoopCondition": "error",
        "noAccidentalBitwiseOperators": "error",
        "noArgumentsCallerOrCallee": "error",
        "noDoubleComparison": "error",
        "noInvalidThis": "error",
        "noJsRestrictedProperties": "error",
        "noNestedSwitch": "error",
        "noNestedTemplateLiterals": "error",
        "noObjectConstructor": "error",
        "noOctal": "error",
        "noUnsafeUnaryMinus": "error",
        "noUselessCall": "error",
        "noUselessDateGetTime": "error",
        "useBigintLiterals": "error",
        "useCapitalizedConstructors": "error",
        "useConsistentBlockLang": "error",
        "useConsistentJsonFileRead": "error",
        "useMatchingFunctionName": "error",
        "useNamedFunction": "error",
        "useUnaryMinus": "error",
        "noConsoleSpaces": "error",
        "noArraySortForMinMax": "error",
        "noBooleanSortComparator": "error",
        "noEagerArrayMethodsInLoops": "error",
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "noUnmodifiedLoopCondition": "error",
        "noUnreadableForOfExpression": "error",
        "noUnsafeReturn": "error",
        "noUselessAssignment": "error",
        "useIncludes": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    },
    "globals": [
      "GM",
      "GM_info",
      "GM_xmlhttpRequest",
      "unsafeWindow",
      "__FF_SCOUTER_V2_VERSION__",
      "__FF_SCOUTER_EDITION__"
    ]
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": ["src/utils/logger.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "nursery": {
            "noUnsafeReturn": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "src/tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "performance": {
            "useTopLevelRegex": "off",
            "noDelete": "off"
          },
          "nursery": {
            "noFloatingPromises": "off",
            "noUnsafeReturn": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/__fixtures__/**/*.html", "stat_icons.svg"],
      "linter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": [
        "src/features/faction/__fixtures__/torn-markup/2026-09-28/war-row-hospital-until.html",
        "src/features/status-attack/__fixtures__/torn-markup/2026-07-26/war-list-enemy-rows.html"
      ],
      "formatter": {
        "enabled": false
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
